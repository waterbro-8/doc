// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// 数据模型
model Doc {
  id             String          @id @default(cuid())
  icon           String? // emoji icon
  title          String
  content        String
  contentBinary  Bytes?
  contentSearch  String? // plain-text extraction of TipTap JSON for search
  /// Trigger-maintained tsvector. Prisma has no first-class tsvector type; the
  /// column and GIN index are created by prisma/preflight/ensure-search-index.sql
  /// and are not read or written through the Prisma client.
  search_vector  Unsupported("tsvector")?
  isDeleted      Boolean         @default(false)
  isStar         Boolean         @default(false)
  sortOrder      Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  parent         Doc?            @relation("ChildrenDocs", fields: [parentId], references: [id])
  parentId       String?
  children       Doc[]           @relation("ChildrenDocs")
  sharePassword  String? // 不再使用 sharePassword ，改为使用 shareRelations
  shareRelations ShareRelation[]
  pubDoc         PubDoc[]
  versions       DocVersion[]
  comments       DocComment[]

  @@index([userId, parentId, sortOrder])
}

model TokenUsage {
  id            String   @id @default(cuid())
  userId        String   @unique
  model         String   @default("gpt-3.5-turbo")
  totalTokens   Int      @default(0)
  tokensLimit   Int      @default(100000)
  updateLimitAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth Adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  isAdmin              Boolean               @default(false)
  accounts             Account[]
  sessions             Session[]
  docs                 Doc[]
  tokenUsage           TokenUsage?
  isInvited            Boolean?              @default(false) // no more use this field
  myShares             ShareRelation[]       @relation("myShares")
  shareRelations       ShareRelation[]       @relation("shareRelations")
  pubDocs              PubDoc[]              @relation("pubDocs")
  docVersions          DocVersion[]
  personalAccessTokens PersonalAccessToken[]
  comments             DocComment[]
}

enum PersonalAccessTokenScope {
  DOCUMENTS_READ
  DOCUMENTS_WRITE
}

model PersonalAccessToken {
  id          String                     @id @default(cuid())
  userId      String
  name        String                     @db.VarChar(80)
  tokenHash   String                     @unique @db.Char(64)
  tokenPrefix String                     @db.VarChar(20)
  scopes      PersonalAccessTokenScope[]
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                   @default(now())
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, revokedAt])
}

model DocVersion {
  id            String   @id @default(cuid())
  docId         String
  userId        String
  title         String
  content       String
  contentBinary Bytes
  createdAt     DateTime @default(now())

  doc  Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt(sort: Desc)])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// no more use this model
model InvitationCode {
  id   Int    @id @default(autoincrement())
  code String @unique
}

model ShareRelation {
  id         String     @id @default(cuid())
  docId      String
  authorId   String
  userId     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime?
  doc        Doc        @relation(fields: [docId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], name: "myShares")
  user       User       @relation(fields: [userId], references: [id], name: "shareRelations")
  access     AccessType @default(READ)
  noticeType NoticeType @default(NEW)

  @@unique([docId, userId])
  @@index([expiresAt])
}

model DocComment {
  id         String    @id @default(cuid())
  docId      String
  userId     String
  body       String    @db.VarChar(4000)
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  doc        Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt(sort: Desc)])
}

enum AccessType {
  READ
  WRITE
}

enum NoticeType {
  NEW
  UPDATE
  NONE
}

enum PubDocStatus {
  PUBLISHED
  FROZEN
  UNPUBLISHED
}

model PubDoc {
  id              String       @id @default(cuid())
  publishId       String       @unique // url suffix
  htmlContent     String
  docId           String
  title           String
  userId          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  status          PubDocStatus @default(PUBLISHED)
  statusReason    String?
  statusUpdatedAt DateTime     @default(now())
  statusUpdatedBy String?
  user            User         @relation(fields: [userId], references: [id], name: "pubDocs")
  doc             Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  thumbUpCount    Int          @default(0)
  likes           PubDocLike[]
}

model PubDocLike {
  id        String   @id @default(cuid())
  viewerId  String
  pubDocId  String
  createdAt DateTime @default(now())

  pubDoc PubDoc @relation(fields: [pubDocId], references: [id], onDelete: Cascade)

  @@unique([viewerId, pubDocId])
  @@index([pubDocId])
}

model AuditLog {
  id             String   @id @default(cuid())
  actor          String
  actorType      String   @default("user") @db.VarChar(20)
  action         String   @db.VarChar(80)
  target         String
  targetType     String?  @db.VarChar(40)
  outcome        String   @db.VarChar(20)
  requestId      String?  @db.VarChar(128)
  idempotencyKey String?  @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([target, createdAt(sort: Desc)])
  @@index([actor, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
