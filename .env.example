# Loopback host ports (change these without editing docker-compose.yml)
DOC_WEB_PORT=3100
DOC_COLLABORATION_PORT=1234
DOC_POSTGRES_PORT=5432
DOC_MAILPIT_SMTP_PORT=1025
DOC_MAILPIT_UI_PORT=8025
DOC_MAILPIT_URL=http://localhost:8025
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXTAUTH_URL=http://localhost:3100
AUTH_SECRET=replace-with-a-random-secret

# PostgreSQL / Prisma
DATABASE_URL=postgresql://doc:doc@localhost:5432/doc?schema=public

# GitHub authentication (both values are required to enable the provider)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email authentication and notifications
# The defaults use the local Mailpit service without credentials.
# For authenticated SMTP, set EMAIL_USERNAME and EMAIL_PASSWORD together.
# Containers use EMAIL_CONTAINER_HOST/PORT; host development uses EMAIL_HOST/PORT.
EMAIL_FROM=doc@example.test
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_CONTAINER_HOST=mailpit
EMAIL_CONTAINER_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SECURE=false
RESEND_API_KEY=
NOTICE_EMAIL_TO=

# Object storage (S3-compatible providers can be adapted behind this surface)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
OSS_BUCKET=
NEXT_PUBLIC_OSS_CDN_HOSTNAME=

# AI providers (OpenAI-compatible). Unconfigured AI features fail closed and send no traffic.
# Generic provider wins when both base URL and API key are set.
DOC_AI_BASE_URL=
DOC_AI_API_KEY=
DOC_AI_MODEL=
DOC_AI_NAME=
DEEP_SEEK_API_KEY=
DEEP_BRICKS_API_KEY=

# Realtime collaboration
NEXT_PUBLIC_COLLABORATE_EDIT_URL=ws://localhost:1234/collaborate
COLLABORATE_EDIT_HTTP_URL=http://localhost:1234
COLLABORATE_API_AUTH_KEY=replace-with-a-shared-token-key
COLLABORATE_INTERNAL_API_KEY=replace-with-an-internal-service-key
